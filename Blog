    .hidden-gallery { display: none; margin-top: 25px; padding-top: 25px; border-top: 1px solid rgba(0,0,0,0.05); }
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
    .gallery-grid img { width: 100%; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); }

    /* Contact Section */
    .contact-wrapper { text-align: center; max-width: 600px; margin: 0 auto; }
    .contact-wrapper .card { background: linear-gradient(135deg, var(--dark) 0%, #1E293B 100%); color: #fff; border: 1px solid rgba(255,255,255,0.1); }
    .contact-wrapper h2 { color: #fff; margin-bottom: 20px; }
    .contact-wrapper p { color: #94A3B8; margin-bottom: 30px; }

    /* Footer */
    footer { border-top: 1px solid rgba(0,0,0,0.05); text-align: center; padding: 40px 5%; margin-top: 50px; color: var(--text-muted); font-size: 0.9rem; }

    .blog-list-item {
      display: block;
      background: var(--card-bg);
      backdrop-filter: blur(10px);
