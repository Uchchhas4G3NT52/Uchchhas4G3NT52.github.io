    .project-card .tags { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .tag { background: #EEF2FF; color: var(--primary); padding: 5px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 600; border: 1px solid rgba(79, 70, 229, 0.2); }
    .project-card p { color: var(--text-muted); margin-bottom: 15px; }

    .tag { background: #EEF2FF; color: var(--primary); padding: 5px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 600; border: 1px solid rgba(79, 70, 229, 0.2); }
    .project-card p { color: var(--text-muted); margin-bottom: 15px; }

    .expandable-card { cursor: pointer; }
    .card-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(255,255,255,0.95);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
